# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Get a key at https://dashboard.api-football.com (free tier: ~100 requests/day).
# Leave unset to keep using the built-in mock data (MockFootballProvider) — the
# app runs exactly the same either way, only server/src/football/providers/index.ts
# cares which one is active.
API_FOOTBALL_KEY=

# Optional: pin a specific season (e.g. "2023" for the 2023-24 season)
# instead of whichever season the provider marks current. Needed on a free
# API-Football plan, which typically can't see the live current season —
# only recent past ones. Leave unset once your plan covers the live season.
FOOTBALL_SEASON_YEAR=

# Background job intervals, in milliseconds. Only the jobs that call the
# football provider spend API budget — defaults below are sized for a free
# ~100-req/day plan. Raise these (or remove to fall back to the default) once
# you know your actual plan's limit. Jobs not listed here (settlement, price
# updates, standings cache) only touch the local database and are unmetered.
JOB_IMPORT_SEASON_MS=
JOB_REFRESH_FIXTURES_MS=
JOB_REFRESH_STANDINGS_MS=
JOB_REFRESH_ODDS_MS=
JOB_MONITOR_LIVE_MS=
